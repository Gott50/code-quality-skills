          "path": ".gitignore",
          "action": "merge",
          "scope": "root",
          "template": "templates/biome-assist/gitignore.block"
        }
      ],
      "commands": [
        {
          "run": "bun install",
          "scope": "root",
          "showInPlan": false
        },
        {
          "run": "bunx @biomejs/biome check --write --unsafe --linter-enabled=false .",
